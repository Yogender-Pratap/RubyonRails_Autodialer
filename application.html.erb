<!DOCTYPE html>
<html>
  <head>
    <title>Autodialer</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <h1>Autodialer</h1>
    <nav>
      <%= link_to "Contacts", contacts_path %> | 
      <%= link_to "Call Logs", calls_path %>
    </nav>
    
    <hr>
    
    <% if notice %>
      <p style="color: green;"><%= notice %></p>
    <% end %>
    
    <% if alert %>
      <p style="color: red;"><%= alert %></p>
    <% end %>
    
    <%= yield %>
  </body>
</html>
