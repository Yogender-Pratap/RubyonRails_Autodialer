<h2>Call Logs</h2>

<table border="1">
  <tr>
    <th>Time</th>
    <th>Phone</th>
    <th>Status</th>
    <th>Duration</th>
    <th>Error</th>
  </tr>
  <% @call_logs.each do |log| %>
    <tr>
      <td><%= log.started_at %></td>
      <td><%= log.contact.phone_number %></td>
      <td><%= log.status %></td>
      <td><%= log.duration %></td>
      <td><%= log.error_message %></td>
    </tr>
  <% end %>
</table>

<%= link_to "Back", contacts_path %>
